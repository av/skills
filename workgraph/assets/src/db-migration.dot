// workgraph README sample: database migration (mid-run).
// Back edges (class "back top|bottom") are left out of the layout and drawn by
// render.mjs as brackets above or below the nodes they span.
digraph db_migration {
  plan        [class=verified, group=main]
  schema      [class=verified, group=main]
  dual_write  [class=verified, group=main]
  backfill    [class=running, label="backfill ×2"]
  parity      [class=failed, group=main]
  read_switch [class=pending, group=main]
  soak        [class=pending, group=main]
  rollback    [class=pending]
  drop_old    [class=pending, group=main]
  cleanup     [class=pending, group=main]

  plan -> schema
  schema -> dual_write
  schema -> backfill
  dual_write -> parity
  backfill -> parity
  parity -> backfill [class="back bottom", label=FAIL]
  parity -> read_switch
  read_switch -> soak
  soak -> rollback [xlabel=FAIL]
  soak -> drop_old
  drop_old -> cleanup
  rollback -> plan [class="back top"]
}
